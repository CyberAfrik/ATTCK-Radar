APP_NAME="ATT&CK Radar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://radar.cyber-afrik.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Envoi par SMTP authentifié (sendmail ne fonctionne pas si proc_open est désactivé)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="radar@example.com"
MAIL_FROM_NAME="ATT&CK Radar"

# Adresses autorisées dans /admin (connexion par lien email), séparées par des virgules
RADAR_ADMIN_EMAILS=
# Conservation des demandes d'export, en jours (0 = illimitée)
RADAR_RETENTION_DAYS=730

# URL du paquet de référentiel publié par GitHub Actions (mise à jour hebdomadaire)
# RADAR_PACK_URL=https://github.com/CyberAfrik/ATTCK-Radar/releases/download/referentiel
